  "description": "MINDClaw — OpenClaw with MIND baked in. Persistent knowledge graph memory by default. One install, one command, fully wired.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mindclaw": "./bin/mindclaw.mjs"
  },
  "files": [
    "bin",
    "src",
    "templates",
    "docs/mindclaw.html",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test src/lib/*.test.mjs 2>/dev/null || echo 'no tests yet'",
    "lint": "node --check bin/mindclaw.mjs && find src -name '*.mjs' -exec node --check {} +"
  },
  "keywords": [
    "mindclaw",
    "openclaw",
    "mind",
    "mindapp",
    "knowledge-graph",
    "ai-memory",
    "persistent-memory",
    "obsidian-alternative",
    "personal-ai",
    "agent",
    "mcp",
    "model-context-protocol"
  ],
  "author": "Astra AI <hello@theastraway.com>",
  "homepage": "https://www.m-i-n-d.ai/mindclaw.html",
  "repository": {
    "type": "git",
    "url": "https://github.com/theastraway/mindclaw.git"
  },
  "bugs": {
    "url": "https://github.com/theastraway/mindclaw/issues"
  },
  "dependencies": {
    "openclaw": "^2026.5.3",
    "@astramindapp/openclaw-mind": "^0.1.0"
  },
  "engines": {
    "node": ">=18"
  }
